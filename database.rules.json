{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      "$code": {
        ".read": "auth != null && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || !data.exists() || data.child('status').val() === 'open')",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || (data.child('status').val() === 'open' && !data.child('guestUid').exists() && newData.child('guestUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['hostUid', 'createdAt', 'status']) && newData.child('hostUid').isString() && newData.child('createdAt').isNumber() && newData.child('status').val().matches(/^(open|full|closed)$/) && $code.matches(/^[A-Z0-9]{4,8}$/)",
        "hostUid": {
          ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || data.val() === newData.val())"
        },
        "guestUid": {
          ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "status": {
          ".validate": "newData.val().matches(/^(open|full|closed)$/)"
        }
      }
    },
    "matches": {
      "$code": {
        ".read": "auth != null && (root.child('lobbies').child($code).child('hostUid').val() === auth.uid || root.child('lobbies').child($code).child('guestUid').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z0-9]{4,8}$/)",
        "setup": {
          ".write": "auth != null && root.child('lobbies').child($code).child('hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['seed', 'mapId', 'difficulty', 'hostSpecies', 'startedAt']) && newData.child('seed').isNumber() && newData.child('mapId').isString() && newData.child('difficulty').isString() && newData.child('hostSpecies').isString() && newData.child('startedAt').isNumber()"
        },
        "guestSpecies": {
          ".write": "auth != null && root.child('lobbies').child($code).child('guestUid').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "cmd": {
          "$uid": {
            "$tick": {
              ".write": "auth != null && $uid === auth.uid && (root.child('lobbies').child($code).child('hostUid').val() === auth.uid || root.child('lobbies').child($code).child('guestUid').val() === auth.uid)",
              ".validate": "$tick.matches(/^[0-9]+$/) && newData.isString() && newData.val().length <= 8000"
            }
          }
        },
        "hash": {
          "$uid": {
            "$tick": {
              ".write": "auth != null && $uid === auth.uid && (root.child('lobbies').child($code).child('hostUid').val() === auth.uid || root.child('lobbies').child($code).child('guestUid').val() === auth.uid)",
              ".validate": "$tick.matches(/^[0-9]+$/) && newData.isString() && newData.val().length <= 16"
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (root.child('lobbies').child($code).child('hostUid').val() === auth.uid || root.child('lobbies').child($code).child('guestUid').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().matches(/^(here|away)$/)"
          }
        }
      }
    },
    "stats": {
      ".read": false,
      ".write": false,
      "summaries": {
        "$summaryId": {
          ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
          ".write": "auth != null && (!data.exists() && newData.child('ownerUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['ownerUid', 'endedAtMs', 'result', 'species', 'won']) && newData.child('ownerUid').val() === auth.uid && newData.child('endedAtMs').isNumber() && newData.child('result').val().matches(/^(victory|defeat)$/) && newData.child('species').isString() && newData.child('won').isBoolean()"
        }
      },
      "daily": {
        "$day": {
          ".read": "auth != null",
          ".write": false,
          ".validate": "$day.matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        }
      }
    },
    "moderation": {
      ".read": false,
      ".write": false,
      "events": {
        "$eventId": {
          ".read": "auth != null && data.child('byAdminUid').val() === auth.uid",
          ".write": false
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['updatedAt']) && newData.child('updatedAt').isNumber()",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
        },
        "ageGateOk": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        }
      }
    }
  }
}
