# Kane — Vite public Firebase config (safe to commit as example only).
# Copy to `.env.local` for Auth / Firestore / emulator work. Never put secrets here.
# Soft launch: ads stay off; local SP Vite path works without these (guest play).
# Production project: kane-rts-game (https://kane-rts-game.web.app).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kane-rts-game.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kane-rts-game
VITE_FIREBASE_DATABASE_URL=https://kane-rts-game-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=kane-rts-game.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# When true, client points Auth / Firestore / RTDB at local emulators
# (Auth 9099 / RTDB 9000 / Firestore 8080). Use with `npm run emulators`.
VITE_FIREBASE_USE_EMULATORS=false

# Phase 7 #/admin: open (local-dev default) or allowlist (deny unless listed).
VITE_ADMIN_ACCESS_MODE=open
