# Kane — Vite public Firebase placeholders (safe to commit as example only).
# Copy to `.env.local` for emulator work. Never put secrets here.
# Soft launch: ads stay off; local SP Vite path does not need these.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=kane-rts-stub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kane-rts-stub
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=kane-rts-stub
VITE_FIREBASE_STORAGE_BUCKET=kane-rts-stub.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:demo

# When true, client stubs point at local emulators (Auth 9099 / RTDB 9000 / Firestore 8080).
VITE_FIREBASE_USE_EMULATORS=false
