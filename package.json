{
  "name": "kane",
  "private": true,
  "version": "0.1.0",
  "description": "KANE — BUILD. COMMAND. CONQUER. Fantasy RTS vertical slice (Phaser 4, local-first)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "test": "vitest run --dir src",
    "emulators": "firebase emulators:start",
    "emulators:exec": "firebase emulators:exec --only auth,database,firestore",
    "hosting:preview": "npm run build && firebase hosting:channel:deploy kane-preview --expires 7d --only kane-web",
    "hosting:deploy": "npm run build && firebase deploy --only hosting:kane-web",
    "hosting:channels": "firebase hosting:channel:list"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "firebase-tools": "^13.35.1",
    "globals": "^17.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
